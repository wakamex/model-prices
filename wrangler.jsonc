// The website, served as Workers static assets at model-prices.com.
{
  "name": "model-prices",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./site/public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "model-prices.com", "custom_domain": true },
    { "pattern": "www.model-prices.com", "custom_domain": true }
  ]
}
